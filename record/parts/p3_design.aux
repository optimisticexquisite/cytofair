\@writefile{toc}{\contentsline {section}{\numberline {24.5}2A: adversarial fingerprint suppression}{73}{section.24.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {24.4}{\ignorespaces The adversarial suppression arms. The parent adversary only competes among parents of the sample's own class, so suppressing it never requires removing class information. Study 2 (2A) used a two-layer MLP; Amendment 8 (F7) used a probe-matched head (per-feature standardisation and one linear layer, its own optimiser at $10^{-3}$, re-initialised every five epochs) so that features could not hide parent identity from it while leaving it readable by a linear probe.\relax }}{73}{figure.caption.57}\protected@file@percent }
\newlabel{r:fig:adversary}{{24.4}{73}{The adversarial suppression arms. The parent adversary only competes among parents of the sample's own class, so suppressing it never requires removing class information. Study 2 (2A) used a two-layer MLP; Amendment 8 (F7) used a probe-matched head (per-feature standardisation and one linear layer, its own optimiser at $10^{-3}$, re-initialised every five epochs) so that features could not hide parent identity from it while leaving it readable by a linear probe.\relax }{figure.caption.57}{}}
\newlabel{r:fig:adversary@cref}{{[figure][4][24]24.4}{[1][73][]73}}
